{
  "name": "ludone-desktop-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "Klikatelná kostra menu-bar spouštěče LuDone Desktop",
  "main": "electron/main.cjs",
  "type": "module",
  "build": {
    "appId": "cz.ludone.desktop",
    "productName": "LuDone Desktop",
    "asar": false,
    "allowMissingDependencies": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "package.json",
      "dist/**/*",
      "electron/**/*",
      "src/lib/**/*",
      "src/pisma/**/*"
    ],
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "mac": {
      "hardenedRuntime": true,
      "notarize": true,
      "entitlements": "scripts/entitlements.mac.plist",
      "entitlementsInherit": "scripts/entitlements.mac.plist",
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "12.0.0",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "LSUIElement": true,
        "NSMicrophoneUsageDescription": "LuDone potřebuje mikrofon pro oddělenou nahrávku vašeho hlasu.",
        "NSAudioCaptureUsageDescription": "LuDone zachytává zvuk z ostatních aplikací, aby v nahrávce schůzky byla slyšet i druhá strana."
      }
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Make-more-s-r-o",
        "repo": "ludone-desktop",
        "private": false,
        "releaseType": "release"
      }
    ]
  },
  "scripts": {
    "build": "vite build",
    "ikony": "node scripts/tray-ikony.mjs",
    "start": "electron .",
    "package:mac": "npm run build && node scripts/package-mac.mjs",
    "release:mac": "npm run build && node scripts/package-mac.mjs --publish always",
    "progress": "node scripts/desktop-progress.mjs",
    "vzorky": "electron scripts/vzorky-exportu.mjs",
    "test:audio": "node scripts/audio-smoke.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "test:tray-image": "electron tests/tray-image-electron.js",
    "test:unit": "vitest run",
    "gates": "npm run lint && npm run typecheck && npm run test:unit && npm run preskocene",
    "gates:clean": "node scripts/gates-clean.mjs",
    "hooks:install": "git config core.hooksPath .githooks && echo \"Hooky zapnuté (.githooks). Vypnutí: git config --unset core.hooksPath\"",
    "preskocene": "node scripts/preskocene.mjs",
    "preskocene:baseline": "node scripts/preskocene.mjs --zapis-baseline"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^3.2.7",
    "electron": "39.8.10",
    "electron-builder": "26.15.3",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "7.1.3",
    "vitest": "^3.2.7"
  }
}
