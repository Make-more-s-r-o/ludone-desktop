{
  "name": "ludone-desktop-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "Klikatelná kostra menu-bar spouštěče LuDone Desktop",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "start": "electron .",
    "package:mac": "npm run build && node scripts/package-mac.mjs",
    "test:audio": "node scripts/audio-smoke.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "test:unit": "vitest run",
    "gates": "npm run lint && npm run typecheck && npm run test:unit"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^3.2.7",
    "electron": "37.3.1",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "7.1.3",
    "vitest": "^3.2.7"
  }
}
